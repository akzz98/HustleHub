{
  "info": {
    "_postman_id": "hustlehub-plus-assessment",
    "name": "HustleHub+",
    "description": "HustleHub+ Part 2 API collection.\n\nBase URL defaults to https://localhost:3000.\n\nSelf-signed certificates: in Postman go to Settings and turn off SSL certificate verification.\n\nSuggested order: Auth Setup → Gigs → Bookings → Income → Negatives.\n\nAdmin requests need `adminToken` from a development seed login (not public register).\n\nNewman: `npx newman run postman/HustleHub.postman_collection.json -k`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:3000" },
    { "key": "runId", "value": "" },
    { "key": "clientEmail", "value": "" },
    { "key": "freelancerEmail", "value": "" },
    { "key": "otherFreelancerEmail", "value": "" },
    { "key": "password", "value": "SecurePassword123!" },
    { "key": "clientToken", "value": "" },
    { "key": "freelancerToken", "value": "" },
    { "key": "otherFreelancerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "token", "value": "" },
    { "key": "gigId", "value": "" },
    { "key": "otherGigId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "transactionId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  const runId = Date.now().toString();",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('clientEmail', `client-${runId}@example.com`);",
          "  pm.collectionVariables.set('freelancerEmail', `freelancer-${runId}@example.com`);",
          "  pm.collectionVariables.set('otherFreelancerEmail', `other-free-${runId}@example.com`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET / — health + security headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('CSP present', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Security-Policy')).to.include(\"default-src 'self'\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "Auth Setup",
      "item": [
        {
          "name": "Register client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Public fields only', () => {",
                  "  pm.expect(body).to.have.keys('id', 'name', 'email');",
                  "  pm.expect(body.password).to.be.undefined;",
                  "  pm.expect(body.role).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Client\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"client\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
