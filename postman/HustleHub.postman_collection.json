    {
      "name": "Bookings and Transactions",
      "item": [
        {
          "name": "POST /api/bookings — create (client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Has confirmation + transaction', () => {",
                  "  pm.expect(body.confirmation.paymentSimulated).to.eql(true);",
                  "  pm.expect(body.transaction.amount).to.eql(175);",
                  "  pm.expect(body.transaction.bookingId).to.eql(body.id);",
                  "});",
                  "pm.collectionVariables.set('bookingId', body.id);",
                  "pm.collectionVariables.set('transactionId', body.transaction.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{clientToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gigId\": \"{{gigId}}\"\n}"
