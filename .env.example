PORT=3000
NODE_ENV=development
JWT_SECRET=""
JWT_EXPIRES_IN=1h
MONGODB_URI=mongodb://127.0.0.1:27017/hustlehub
SSL_KEY_PATH=certs/localhost-key.pem
SSL_CERT_PATH=certs/localhost.pem
# Browser origin allowed to call the API (Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173

# Optional Better Stack (Logtail) cloud logging. Leave blank for stdout only.
# Never commit real tokens.
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGEST_URL=

# Development-only admin seed (npm run seed:admin). Never use weak values in shared/prod envs.
ADMIN_SEED_NAME=Local Admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=""
